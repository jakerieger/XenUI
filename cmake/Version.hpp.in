#pragma once

#include "XenUI/Api.hpp"

/// @file
/// @brief The version of XenUI these headers belong to. Generated by CMake from cmake/Version.hpp.in.

#define XENUI_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define XENUI_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define XENUI_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define XENUI_VERSION_STRING "@PROJECT_VERSION@"

namespace XenUI {
    struct VersionInfo {
        int Major = 0;
        int Minor = 0;
        int Patch = 0;
    };

    /// @brief The version of the headers being compiled against.
    inline constexpr VersionInfo kVersion {XENUI_VERSION_MAJOR, XENUI_VERSION_MINOR, XENUI_VERSION_PATCH};

    /// @brief The version of the XenUI DLL loaded at run time, which can differ from kVersion when the DLL is
    /// replaced without recompiling.
    [[nodiscard]] XENUI_API VersionInfo GetRuntimeVersion();
}  // namespace XenUI
