# Doxygen configuration for the XenUI API reference.
# Run `doxygen` from the repository root; the site is written to Docs/html (git ignored).
# Only settings that differ from Doxygen's defaults are listed here.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = XenUI
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "GPU-accelerated Windows GUI framework for C++20"
OUTPUT_DIRECTORY       = Docs
CREATE_SUBDIRS         = NO
STRIP_FROM_PATH        = Source \
                         .
STRIP_FROM_INC_PATH    = Source
FULL_PATH_NAMES        = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TOC_INCLUDE_HEADINGS   = 3
TAB_SIZE               = 4
INLINE_INHERITED_MEMB  = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
INTERNAL_DOCS          = NO
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SHOW_USED_FILES        = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         Docs \
                         Source/XenUI
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp \
                         *.md
RECURSIVE              = YES
EXCLUDE                = Docs/html
EXCLUDE_PATTERNS       = */Pch.hpp \
                         */AppContext.hpp \
                         */*Impl.hpp \
                         */Platform/Accessibility.hpp \
                         */Platform/HResult.hpp \
                         */Platform/PopupManager.hpp \
                         */Platform/SystemDragDrop.hpp \
                         */Graphics/D2D*.hpp \
                         */Graphics/DeviceLost.hpp \
                         */Graphics/GraphicsDevice.hpp \
                         */Graphics/LiveRenderer.hpp \
                         */Graphics/SwapChain.hpp
EXCLUDE_SYMBOLS        = detail \
                         *::detail::*
IMAGE_PATH             = Docs/Images
USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = Source
PREDEFINED             = XENUI_API= \
                         XENUI_EXPORTS \
                         _WIN32 \
                         __cplusplus=202002L

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = Docs/css/doxygen-awesome.css \
                         Docs/css/doxygen-awesome-sidebar-only.css
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_SECTIONS  = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
ENUM_VALUES_PER_LINE   = 1
TREEVIEW_WIDTH         = 280

#---------------------------------------------------------------------------
# Other outputs
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
