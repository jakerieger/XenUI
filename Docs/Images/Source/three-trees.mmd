    e2["RenderElement for Padding"]
    e3["RenderElement for DecoratedBox"]
    e4["ComponentElement for Text"]
    e5["RenderElement for Paragraph"]
    e1 --> e2 --> e3 --> e4 --> e5
  end
  subgraph R["Render objects"]
    direction LR
    r1["RenderPadding"]
    r2["RenderDecoratedBox"]
    r3["RenderParagraph"]
